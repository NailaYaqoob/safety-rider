# ─────────────────────────────────────────────────────────────────────────────
# FortyGuard Temperature API
# ─────────────────────────────────────────────────────────────────────────────

# Your FortyGuard API key. REQUIRED for live readings — without it every
# temperature lookup falls back to the deterministic simulator and each reply
# is labelled SIMULATED. The notebooks read the same variable.
FORTYGUARD_API_KEY=your-fortyguard-api-key

# ─────────────────────────────────────────────────────────────────────────────
# Meta WhatsApp Cloud API (safety_rider/ service)
# ─────────────────────────────────────────────────────────────────────────────

# A string YOU invent. Paste the same value into the Meta App Dashboard when you
# save the Callback URL. Meta echoes it back on the GET handshake and we only
# return the challenge if it matches. Any random string works — make it long.
WHATSAPP_VERIFY_TOKEN=invent-a-long-random-string

# Meta App Secret — App Dashboard > Settings > Basic > App Secret.
# Used to verify the X-Hub-Signature-256 header on every inbound POST, so we
# only act on payloads Meta actually signed. REQUIRED: without it the service
# rejects all POSTs rather than trusting unsigned input.
WHATSAPP_APP_SECRET=your-app-secret-from-settings-basic

# Graph API access token used as the outbound bearer token.
# The 24-hour token in WhatsApp Manager > API Setup is fine for a first test,
# but it expires overnight. Issue a System User token (Business Settings >
# System Users > Generate Token, scopes whatsapp_business_messaging +
# whatsapp_business_management) for anything that has to survive a demo.
WHATSAPP_ACCESS_TOKEN=your-system-user-access-token

# Numeric ID of your sending phone number (WhatsApp Manager > API Setup).
# This is the *ID*, not the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Graph API version to pin. Meta deprecates versions on a ~2-year cadence.
WHATSAPP_GRAPH_API_VERSION=v21.0

# Set to 1 to log full inbound payloads. Leave OFF in production — payloads
# contain rider phone numbers and precise locations.
SAFETY_RIDER_DEBUG_PAYLOADS=0

# ── Heat layer tuning (safety_rider/heat_layer.py) ───────────────────────────
# Set to 0 to force the stub evaluator even with a valid FortyGuard key — lets
# you demo the WhatsApp path without spending credits.
SAFETY_RIDER_LIVE_HEAT=1

# Cache-grid cell size in degrees (~0.05 deg = 5.5 km). Riders inside one cell
# share a single fetched heat layer, so this is the main cost control.
SAFETY_RIDER_GRID_DEG=0.05

# Half the AOI square's side in metres. 5000 -> a 10x10 km AOI (~100 km2),
# comfortably larger than one grid cell. Must stay inside your tier's area cap.
SAFETY_RIDER_AOI_HALF_SIDE_M=5000

# Heatmap resolution. The API accepts 60, 80, or 100 metres ONLY.
SAFETY_RIDER_GRANULARITY_M=100

# Set to 1 to ignore cached layers and re-bill every call.
SAFETY_RIDER_HEAT_REFRESH=0

# Poll budget (seconds) for one FortyGuard task on the RIDER path. The SDK
# default is 600, which is far too long for someone waiting on WhatsApp — a
# slow task fails fast and the rider gets a fallback answer instead of silence.
SAFETY_RIDER_HEAT_TIMEOUT_S=120

# Poll budget for the out-of-band warmer (safety_rider/warm.py), which nobody
# is waiting on. Generous on purpose: the same request measured 219 s once and
# was still 'Processing' past 120 s hours later — queue depth, not tile count,
# sets the wait. Timing out is the expensive failure, because abandoning the
# poll does not cancel the billed job; it throws away an answer you paid for.
SAFETY_RIDER_HEAT_WARM_TIMEOUT_S=900

# How many days back to measure. MUST NOT be 0: "today" returns only the hours
# already elapsed, so a morning query sees overnight temperatures and reports
# a dangerously low risk.
#
# 3, not 1. A day the catalog has not finished ingesting does NOT error — it
# returns one hour's snapshot with min == mean == max, which reads as a cool,
# safe day. Measured across San Jose and Phoenix, one and two days back were
# both still flat while three was complete. Starting lower costs a wasted
# billed heatmap request before the partial-day check steps back.
SAFETY_RIDER_DAYS_BACK=3

# How many further days to walk back when a day comes back partial. Each step
# costs one heatmap request, so keep it small.
SAFETY_RIDER_BACKFILL_DAYS=6

# ── Nowcast (the current hour, not just the last complete day) ───────────────
# Set to 0 to ignore the hourly layer entirely and band on the daily peak.
#
# With it on, the rider is told what it is *right now* rather than what the
# last complete day peaked at. This is a nowcast and never a forecast: hours
# that have not happened return an empty layer, silently.
#
# Costs nothing on the rider path — the hourly layer is read CACHE-ONLY, so a
# cold cell simply has no nowcast. The spend happens out of band in
# safety_rider/warm.py, bounded by service area rather than by traffic.
SAFETY_RIDER_NOWCAST=1

# How many hours to step back looking for a warm hourly layer. These are cache
# lookups, not requests, so this is free — it exists so a cell warmed at :00
# still answers at :59.
SAFETY_RIDER_NOWCAST_LOOKBACK=3

# ── Cooler-route comparison (safety_rider/routing.py) ────────────────────────
# OSRM instance used for candidate route geometry. The public demo server works
# but is rate-limited, returns no alternatives, and offers no uptime guarantee.
# Run your own before anyone depends on this.
SAFETY_RIDER_OSRM_URL=https://router.project-osrm.org

# OSRM profile. The public demo only serves "driving"; a self-hosted instance
# can offer "cycling", which matches a bike courier better.
SAFETY_RIDER_OSRM_PROFILE=driving

SAFETY_RIDER_OSRM_TIMEOUT_S=15

# Hard cap on heat-grid cells priced per route. Each NEW cell costs two heatmap
# requests, so without this a long route could quietly spend a fortune. Cells
# already cached are free, so raising this is cheap inside a warmed service area
# and expensive outside one.
SAFETY_RIDER_MAX_ROUTE_CELLS=4

# ── Temperature source (safety_rider/temperature_service.py) ─────────────────
# Set to 1 to answer every lookup from the deterministic simulator instead of
# the API: no key, no credits, no network. The same pin always returns the same
# number, so a demo is reproducible. Distinct from SAFETY_RIDER_LIVE_HEAT above,
# which disables the live path everywhere.
SAFETY_RIDER_MOCK_TEMPERATURE=0

# Pin the simulated temperature to an exact value in Celsius. The only reliable
# way to demo the Danger branch (40+) on a mild day. Leave unset to derive the
# value from the location instead.
# SAFETY_RIDER_MOCK_TEMP_C=41.5

# ── Nowcast warmer schedule (safety_rider/warm.py) ──────────────────────────
# Cells to keep warm, as "lat,lon; lat,lon". EMPTY BY DEFAULT — every pass
# spends real credits (one billed heatmap request per cell per hour), so
# nothing runs until you name the ground you actually cover.
#
# The schedule runs INSIDE the service, not as a separate cron container or a
# CI job. A warmed layer is a file in the heat cache directory and the rider
# path reads that same directory, so an external runner would warm its own
# filesystem and the service would never see it. Whatever warms this cache has
# to share the volume with the process reading it.
#
# With this set, replies say what it is RIGHT NOW. Without it, they fall back
# to the last complete day — still correct, just an older timestamp.
SAFETY_RIDER_WARM_CELLS=

# Seconds between passes. The cache key is hour-scoped, so an hour is the
# natural cadence; shorter buys nothing and bills again.
SAFETY_RIDER_WARM_INTERVAL_S=3600

# Hours back to warm per cell per pass. Each one is a separate billed request.
SAFETY_RIDER_WARM_HOURS=1

# ── Shade routing (safety_rider/shade.py) ───────────────────────────────────
# Let tree canopy influence which route is recommended, from FortyGuard
# satellite segmentation (Premium). Reads the segmentation cache ONLY on the
# rider path, so this is free unless the warmer has paid for the cells — with
# nothing cached it is a no-op and routing ranks on temperature alone.
#
# Land cover does not change hour to hour, so a cell is billed once and cached
# with no expiry. `python -m safety_rider.warm <lat> <lon> --shade-only` pays
# for one cell; the scheduled warmer does it for SAFETY_RIDER_WARM_CELLS.
SAFETY_RIDER_SHADE_ROUTING=1

# How many °C of measured air temperature a fully-canopied cell is worth when
# RANKING ROUTES. A modelling assumption, not a measurement: air under canopy
# is only a degree or two cooler, but the radiant load on a body is far lower.
#
# This moves route ranking ONLY. No value here can change the band a rider is
# told — that is decided on measured air temperature at their own position.
SAFETY_RIDER_SHADE_EQUIVALENT_C=3.0

# ── Danger escalation (safety_rider/whatsapp/webhook.py) ────────────────────
# Where a Danger verdict is escalated, in E.164 without the '+'. Unset keeps
# the rest protocol between the service and the rider, which is the honest
# default for a personal demo — but a fleet buys this precisely so a dispatcher
# hears about a stopped rider without waiting for the drop to run late.
#
# Subject to the same 24-hour customer-service window as any free-form message:
# a dispatcher who has never messaged the business number needs a template.
SAFETY_RIDER_DISPATCHER_NUMBER=

# Whether a Danger verdict automatically compares a cooler route to the rider's
# last stated destination, rather than asking someone who has just been told to
# stop riding to type one out. Costs route budget and billed cells.
SAFETY_RIDER_AUTO_REROUTE=1

# ── Per-rider rate limiting (safety_rider/rate_limit.py) ────────────────────
# Meta authenticates the SENDER of a webhook, not the rider inside it, so a
# valid signature says nothing about whether one number is pinning once an hour
# or once a second. Each message can cost billed heat requests and an outbound
# WhatsApp reply, so each rider gets a budget.
#
# 12 per 5 minutes sits far above any human pattern and well below a script.
# Set the limit to 0 to switch it off entirely.
SAFETY_RIDER_RATE_LIMIT=12
SAFETY_RIDER_RATE_WINDOW_S=300

# Routing gets its own, tighter budget: one comparison prices up to
# SAFETY_RIDER_MAX_ROUTE_CELLS cells and each cold cell is two billed heatmap
# requests, so a route can cost an order of magnitude more than a pin. A route
# request refused here hands its general budget back, so over-using route
# comparison can never cost a rider their plain safety check.
SAFETY_RIDER_ROUTE_RATE_LIMIT=4
SAFETY_RIDER_ROUTE_RATE_WINDOW_S=900

# ── Dashboard / demo (safety_rider/dashboard/) ───────────────────────────────
# The ONLY number "Simulate Heat Spike" will message. Taken from the env rather
# than the request body on purpose: the dashboard is reachable through the same
# public tunnel as the webhook, and an endpoint that messaged an arbitrary
# number on request would be an open spam relay.
SAFETY_RIDER_DEMO_NUMBER=

# Set to 0 to disable the Simulate/Reset endpoints entirely. Leave on for a
# hackathon; turn off anywhere the URL outlives the demo.
SAFETY_RIDER_DEV_TOOLS=1

# Set to 1 to show riders' full phone numbers on the dashboard. Off by default
# because the dashboard is built to be screen-shared in a pitch video.
SAFETY_RIDER_DASHBOARD_UNMASK=0

# Where the map opens. Downtown Phoenix — inside FortyGuard's US-only coverage
# and their own worked example. Set this to wherever your riders actually are:
# a map that opens somewhere else reads as a broken dashboard for the seconds
# before it re-frames itself onto the first rider.
SAFETY_RIDER_MAP_LAT=33.4484
SAFETY_RIDER_MAP_LON=-112.0740
